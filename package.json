{
  "name": "hack-devtools",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "description": "Hack-DevTools browser extension",
  "scripts": {
    "test": "node --test tests/core.test.js",
    "test:browser": "node scripts/package.js && node tests/browser.test.js",
    "check": "node scripts/check.js",
    "package": "node scripts/package.js",
    "package:firefox": "node scripts/build-firefox.js",
    "sign:firefox": "npm run package:firefox && web-ext sign --source-dir dist/firefox-unpacked --artifacts-dir dist --channel unlisted",
    "package:all": "npm run package && npm run package:firefox",
    "lint:firefox": "web-ext lint --source-dir dist/firefox-unpacked",
    "test:firefox": "node tests/firefox.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "json5": "2.2.3",
    "web-ext": "^10.8.0"
  }
}
