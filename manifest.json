{
  "manifest_version": 3,
  "name": "Hack-DevTools",
  "version": "1.2.5",
  "description": "A focused DevTools workspace for building requests, transforming text, and composing security test payloads.",
  "minimum_chrome_version": "120",
  "icons": {"48": "assets/logo.png"},
  "action": {
    "default_title": "Hack-DevTools — Blank workspace",
    "default_icon": "assets/logo-inactive.png",
    "default_popup": "popup.html"
  },
  "side_panel": {"default_path": "sidebar.html"},
  "devtools_page": "devtools.html",
  "background": {"service_worker": "src/background.js", "type": "module"},
  "permissions": ["tabs", "storage", "scripting", "webRequest", "declarativeNetRequestWithHostAccess", "sidePanel"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
